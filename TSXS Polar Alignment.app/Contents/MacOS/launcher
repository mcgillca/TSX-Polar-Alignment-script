#!/bin/bash
# TSXS Polar Alignment v2.0 — macOS launcher
# Auto-generated by make_app.py.  Edit make_app.py, not this file.

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
FLAG="$HOME/.tsxpolar_cache/.tsxpolar_ready"
LOG_DIR="$HOME/.tsxpolar_cache"
LOG="$LOG_DIR/launcher.log"
mkdir -p "$LOG_DIR"

if [ ! -f "$FLAG" ]; then
    # First run: first_run.sh is in Contents/Resources/, one level up from us
    SETUP="$(dirname "$0")/../Resources/first_run.sh"
    osascript -e "tell application \"Terminal\" to do script \"bash '$SETUP'\"" 2>/dev/null
    osascript -e "tell application \"Terminal\" to activate" 2>/dev/null
else
    exec >> "$LOG" 2>&1
    echo "=== TSXS Polar Alignment started $(date) ==="
    echo "APP_DIR: $APP_DIR"
    cd "$APP_DIR"
    exec uv run "PAUI.py"
fi
